{
    "trailingComma": "none",
    "endOfLine": "lf",
    "useTabs": false,
    "tabWidth": 2,
    "overrides": [
        {
            "files": ["*.json5"],
            "options": {
                "parser": "jsonc",
                "tabWidth": 4
            }
        },
        {
            "files": ["*.mcmeta"],
            "options": {
                "parser": "json",
                "tabWidth": 4
            }
        },
        {
            "files": ["*.json", "*.jsonc", ".prettierrc"],
            "options": {
                "tabWidth": 4
            }
        }
    ]
}
